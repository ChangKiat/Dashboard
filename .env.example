# Copy from your AI Agent .env
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Your Telegram user ID (ctx.from.id from the bot)
TELEGRAM_USER_ID=

# Optional: Supabase pooler fallback (same as AI Agent)
DATABASE_POOLER_REGION=

# API port (default 3001)
PORT=3001

# TOTP login (authenticator app only)
# Generate: node -e "console.log(new (require('otpauth').Secret)().base32)"
AUTH_TOTP_SECRET=
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Set to 1 once to enable GET /api/auth/setup (QR). Unset after scanning.
# AUTH_TOTP_SETUP=1
