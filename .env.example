# Copy from your AI Agent .env
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Your Telegram user ID (ctx.from.id from the bot)
TELEGRAM_USER_ID=

# Optional: Supabase pooler fallback (same as AI Agent)
DATABASE_POOLER_REGION=

# API port (default 3001)
PORT=3001

# Google sign-in. From the OAuth client in Google Cloud → APIs & Services → Credentials (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on that OAuth client exactly.
# On Render: https://<your-app>.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# The Google accounts that may sign in, comma-separated. Anyone else is refused.
AUTH_ALLOWED_EMAILS=
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=

# Daily jobs (8am weigh-in reminder, 9am fixed bills + interest). Set to 1 on the deployed server only.
SCHEDULER_ENABLED=
# Generate: openssl rand -hex 32. Also add it as the SCHEDULER_SECRET secret of the GitHub repo.
SCHEDULER_SECRET=
# Same value as the AI Agent .env; the job reports go to the TELEGRAM_USER_ID chat.
TELEGRAM_BOT_TOKEN=
